{
  "name": "iptv-licensing-backend",
  "version": "2.1.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "HOST=0.0.0.0 node --watch src/server.js",
    "db:migrate": "sequelize-cli db:migrate --config config/sequelize-cli.cjs --migrations-path src/db/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config config/sequelize-cli.cjs --migrations-path src/db/migrations",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all --config config/sequelize-cli.cjs --migrations-path src/db/migrations",
    "db:seed": "sequelize-cli db:seed:all --config config/sequelize-cli.cjs --seeders-path src/db/seeders",
    "test": "NODE_ENV=test node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "NODE_ENV=test node --test \"tests/unit/*.test.js\"",
    "verify:db": "npm run db:migrate:status",
    "db:migrate:status": "sequelize-cli db:migrate:status --config config/sequelize-cli.cjs --migrations-path src/db/migrations",
    "test:integration": "NODE_ENV=test node --test \"tests/integration/*.test.js\"",
    "test:regression": "node --experimental-vm-modules --test --test-concurrency=1 tests/regression/*.test.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.1",
    "sequelize": "^6.37.8",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "sequelize-cli": "^6.6.2"
  },
  "description": "servidor de licença e ativação do aplicativo DeltaTV",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [
    "iptv",
    "deltaTV"
  ],
  "author": "Luciano",
  "license": "UNLICENSED",
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
