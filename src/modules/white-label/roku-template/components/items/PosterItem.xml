<?xml version="1.0" encoding="UTF-8"?>
<component name="PosterItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/items/PosterItem.brs" />
    <script type="text/brightscript" uri="pkg:/source/Utils.brs" />
    <script type="text/brightscript" uri="pkg:/source/Emoji.brs" />
    <script type="text/brightscript" uri="pkg:/source/EmojiData.brs" />
    <interface>
        <field id="itemContent" type="node" onChange="redraw" />
        <field id="width" type="float" onChange="redraw" />
        <field id="height" type="float" onChange="redraw" />
        <field id="itemHasFocus" type="boolean" onChange="redraw" />
        <field id="rowListHasFocus" type="boolean" onChange="redraw" />
        <field id="gridHasFocus" type="boolean" onChange="redraw" />
        <field id="focusPercent" type="float" />
    </interface>
    <children>
        <Poster id="bg" uri="pkg:/images/round.9.png" />
        <Poster id="icon" opacity="0.25" />
        <Poster id="art" loadDisplayMode="scaleToZoom" />
        <Poster id="shade" uri="pkg:/images/grad_shade.png" />
        <Label id="title" wrap="true" maxLines="3" vertAlign="bottom" lineSpacing="0" />
        <Poster id="mask" uri="pkg:/images/mask.9.png" />
        <Poster id="ring" uri="pkg:/images/ring.9.png" blendColor="0x6B47E6FF" visible="false" />
    </children>
</component>
