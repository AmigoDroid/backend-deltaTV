        <Poster id="card0" translation="[36,322]" width="303" height="139" uri="pkg:/images/card_live.png" />
        <Poster id="card1" translation="[360,322]" width="303" height="139" uri="pkg:/images/card_movies.png" />
        <Poster id="card2" translation="[683,322]" width="303" height="139" uri="pkg:/images/card_series.png" />
