        <Poster id="ring1" translation="[360,322]" width="303" height="139" uri="pkg:/images/ring.9.png" blendColor="0x6B47E6FF" visible="false" />
        <Poster id="ring2" translation="[683,322]" width="303" height="139" uri="pkg:/images/ring.9.png" blendColor="0x6B47E6FF" visible="false" />

