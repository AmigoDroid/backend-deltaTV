        <Label id="ct1" translation="[382,388]" width="240" height="30" text="Filmes" />
        <Label id="ct2" translation="[705,388]" width="240" height="30" text="Séries" />
        <Label id="cs0" translation="[58,420]" width="230" height="22" text="Assista aos canais" />
        <Label id="cs1" translation="[382,420]" width="230" height="22" text="Explore o catálogo" />
        <Label id="cs2" translation="[705,420]" width="230" height="22" text="Suas séries favoritas" />
