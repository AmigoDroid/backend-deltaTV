<?xml version="1.0" encoding="UTF-8"?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="launchArgs" type="assocarray" />
        <field id="inputData" type="assocarray" />
        <field id="memoryEvent" type="assocarray" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/Utils.brs" />
    <script type="text/brightscript" uri="pkg:/source/DeviceId.brs" />
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/Http.brs" />
    <script type="text/brightscript" uri="pkg:/source/Xtream.brs" />
    <script type="text/brightscript" uri="pkg:/source/Lists.brs" />

    <children>
        <Rectangle id="sceneBackground" width="1280" height="720" color="0x090B14FF" />

        <Group id="screens" translation="[260,0]">
            <HomeScreen id="home" visible="false" />
            <FavoritesScreen id="favorites" visible="false" />
            <SettingsScreen id="settings" visible="false" />
        </Group>

        <Label id="loading" translation="[260,330]" width="1020" height="40" horizAlign="center"
            text="Carregando catálogo..." />

        <Sidebar id="sidebar" />

        <!-- Telas ativas: abrem em tela cheia por cima do menu (VOLTAR fecha) -->
        <LiveScreen id="live" visible="false" />
        <CatalogScreen id="movies" kind="movie" visible="false" />
        <CatalogScreen id="series" kind="series" visible="false" />

        <!-- Wi-Fi + relogio (canto superior direito) -->
        <Poster id="wifiIcon" translation="[1172,29]" width="22" height="22"
            uri="pkg:/images/ic_wifi.png" blendColor="0xFFFFFFFF" />
        <Label id="clockLabel" translation="[1202,26]" width="60" height="28" text="--:--"
            vertAlign="center" />

        <DetailScreen id="detail" visible="false" />
        <ConnectScreen id="connect" visible="false" />
        <PlayerScreen id="player" visible="false" />

        <Timer id="clockTimer" repeat="true" duration="20" />
        <Timer id="licenseTimer" repeat="true" duration="60" />
        <Timer id="appearanceTimer" repeat="true" duration="300" />
    </children>
</component>
