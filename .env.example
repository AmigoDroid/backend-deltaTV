NODE_ENV=development
PORT=3000
# Atrás de proxy reverso (nginx, Cloudflare...): número de proxies confiáveis
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=
DB_SSL_STRICT=true

# Segredos: gere com `openssl rand -base64 48` (JWT/PEPPER/WEBHOOK) e `openssl rand -base64 32` (ENCRYPTION_KEY)
JWT_SECRET=
CODE_PEPPER=
ENCRYPTION_KEY=
WEBHOOK_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
DEVICE_ACCESS_TTL_SECONDS=600
DEVICE_REFRESH_TTL_DAYS=30
PLAY_TOKEN_TTL_SECONDS=2592000
PAIRING_TOKEN_TTL_SECONDS=900
# Permite fontes em IPs privados (somente laboratório!)
ALLOW_PRIVATE_SOURCES=false
# Modo proxy: máximo de streams longos simultâneos neste processo (0 = sem limite)
PROXY_MAX_CONCURRENT=20
# URL pública do servidor (HTTPS em produção). É a base que o app recebe no modo proxy (rota espelho Xtream)
PUBLIC_BASE_URL=http://localhost:3000
# Validade da credencial da rota espelho entregue ao app (dias) e tolerância do token nos segmentos HLS (s)
MIRROR_TOKEN_TTL_DAYS=30
# Cache em memória da autorização da rota espelho (modo proxy/redirect, credenciais, sessão). 0 = sempre consulta o banco.
# Mudanças feitas pelo painel (modo/URL do provedor, status de parceria/licença, bloquear/desbloquear/remover dispositivo,
# pagamento/suspensão automática) invalidam o cache DESTE processo na hora. Com mais de um processo, os demais só enxergam
# a mudança em até este tempo (e streams em andamento são cortados pelo recheck, que consulta o banco direto).
MIRROR_AUTH_CACHE_SECONDS=30
HLS_TOKEN_GRACE_SECONDS=21600
#limites
CATALOG_MAX_BYTES=536870912

# Tamanho máximo da playlist M3U baixada da origem, em MB (0 = sem limite)
PLAYLIST_MAX_MB=0
ENABLE_SCHEDULER=true
# Usado apenas pelo seeder do prime iro superadmin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------- Pix ----------------
# Vazio = pagamento por Pix desligado. "mercadopago" = produção. "mock" = só desenvolvimento (admin clica em "Simular pagamento").
PIX_PROVIDER=
# Mercado Pago: painel developers > Suas integrações > Credenciais de produção > Access Token
MP_ACCESS_TOKEN=
# Mercado Pago: Suas integrações > Webhooks > "Chave secreta" (valida a assinatura das notificações). Obrigatório em produção.
# URL a cadastrar no painel (evento "Pagamentos"): {PUBLIC_BASE_URL}/api/v1/webhooks/pix/mercadopago
MP_WEBHOOK_SECRET=
# Validade do QR Code em minutos (mínimo 30)
PIX_EXPIRATION_MINUTES=60

# --- E-mail de saída (painel > E-mails). Deixe SMTP_HOST vazio para desligar. ---
# Use um provedor SMTP autenticado (Brevo, Amazon SES, Resend, Zoho, Gmail com senha de app...) e configure SPF/DKIM do seu domínio.
SMTP_HOST=
SMTP_PORT=587
# true só para porta 465 (TLS direto); na 587 deixe false (STARTTLS é exigido quando há usuário/senha)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DeltaTV <no-reply@seudominio.com>"
MAIL_REPLY_TO=
MAIL_BRAND=DeltaTV
# Quantos e-mails por minuto (respeite o limite do seu provedor) e máximo de destinatários por envio
MAIL_RATE_PER_MINUTE=30
MAIL_MAX_RECIPIENTS=2000

# Player Web: modo de entrega PADRÃO de um acesso web novo, por tipo (api|live|movie|series = proxy|redirect).
# O padrão embutido é api=redirect,live=proxy,movie=redirect,series=redirect. Depois de criado, cada acesso pode ser alterado no painel.
WEB_DELIVERY_DEFAULTS=api=redirect,live=proxy,movie=redirect,series=redirect
